{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "kind": {
          "enum": [
            "input_image",
            "foreground_image",
            "raw_mesh",
            "repaired_mesh",
            "candidate_stl",
            "quality_report",
            "inspection_report",
            "slicer_preview",
            "slicer_confirmation",
            "log"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mesh_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mesh Version"
        },
        "relative_path": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "mm",
                "unitless"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "artifact_id",
        "run_id",
        "kind",
        "relative_path",
        "created_at"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "AssetRecord": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "byte_count": {
          "exclusiveMinimum": 0,
          "maximum": 10485760,
          "title": "Byte Count",
          "type": "integer"
        },
        "content_type": {
          "enum": [
            "image/png",
            "image/jpeg"
          ],
          "title": "Content Type",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Height",
          "type": "integer"
        },
        "relative_path": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "relative_path",
        "content_type",
        "byte_count",
        "width",
        "height"
      ],
      "title": "AssetRecord",
      "type": "object"
    },
    "BudgetPlan": {
      "additionalProperties": false,
      "properties": {
        "budget_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Budget Id",
          "type": "string"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed By"
        },
        "cost_limit_cny": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Limit Cny"
        },
        "inference_timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Timeout S"
        },
        "max_retries": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Retries"
        },
        "preparation_timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preparation Timeout S"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "draft",
            "confirmed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "budget_id",
        "state"
      ],
      "title": "BudgetPlan",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "evidence_artifact_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Artifact Id"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        },
        "threshold": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "tool_version": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "DatasetCase": {
      "additionalProperties": false,
      "properties": {
        "asset_path": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Asset Path",
          "type": "string"
        },
        "case_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "normal",
            "boundary"
          ],
          "title": "Category",
          "type": "string"
        },
        "expected": {
          "enum": [
            "candidate",
            "wait",
            "reject",
            "review",
            "tool_failure"
          ],
          "title": "Expected",
          "type": "string"
        },
        "expected_reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Expected Reason",
          "type": "string"
        },
        "image_should_decode": {
          "title": "Image Should Decode",
          "type": "boolean"
        },
        "license": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "mask_path": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mask Path"
        },
        "object_group": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Object Group",
          "type": "string"
        },
        "reference_mesh": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Mesh"
        },
        "request": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Request",
          "type": "object"
        },
        "request_should_validate": {
          "default": true,
          "title": "Request Should Validate",
          "type": "boolean"
        },
        "result_status": {
          "const": "not_run",
          "default": "not_run",
          "title": "Result Status",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "authorized_p0",
            "procedural_cpu",
            "boundary_fixture"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "split": {
          "enum": [
            "development",
            "evaluation",
            "holdout"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "split",
        "category",
        "object_group",
        "asset_path",
        "source_kind",
        "source_ref",
        "license",
        "image_should_decode",
        "request",
        "expected",
        "expected_reason"
      ],
      "title": "DatasetCase",
      "type": "object"
    },
    "DatasetManifest": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "$ref": "#/$defs/DatasetCase"
          },
          "title": "Cases",
          "type": "array"
        },
        "dataset_version": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/SplitPolicy"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "dataset_version",
        "policy",
        "cases",
        "scope"
      ],
      "title": "DatasetManifest",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_IMAGE",
            "INVALID_ARGUMENT",
            "MODEL_NOT_CONFIGURED",
            "TOOL_UNAVAILABLE",
            "GPU_OUT_OF_MEMORY",
            "TOOL_TIMEOUT",
            "MESH_NOT_PRINTABLE",
            "REPAIR_LIMIT_REACHED",
            "SLICER_VALIDATION_FAILED",
            "WORKER_RESTARTED",
            "REFERENCE_NOT_FOUND",
            "STATE_CONFLICT",
            "BUDGET_NOT_CONFIGURED"
