          "type": "string"
        },
        "non_manifold_edge_count": {
          "minimum": 0,
          "title": "Non Manifold Edge Count",
          "type": "integer"
        },
        "non_manifold_vertex_count": {
          "minimum": 0,
          "title": "Non Manifold Vertex Count",
          "type": "integer"
        },
        "normals_consistent": {
          "title": "Normals Consistent",
          "type": "boolean"
        },
        "unit": {
          "enum": [
            "mm",
            "unitless"
