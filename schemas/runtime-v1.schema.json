        "mesh_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mesh Version"
        },
        "orientation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Orientation"
