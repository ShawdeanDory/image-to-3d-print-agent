        "component_count": {
          "minimum": 0,
          "title": "Component Count",
          "type": "integer"
        },
        "dimensions_mm": {
          "anyOf": [
            {
              "items": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimensions Mm"
