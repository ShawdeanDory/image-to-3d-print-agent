    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_IMAGE",
            "INVALID_ARGUMENT",
            "MODEL_NOT_CONFIGURED",
            "TOOL_UNAVAILABLE",
            "GPU_OUT_OF_MEMORY",
            "TOOL_TIMEOUT",
            "MESH_NOT_PRINTABLE",
            "REPAIR_LIMIT_REACHED",
            "SLICER_VALIDATION_FAILED",
            "WORKER_RESTARTED",
            "REFERENCE_NOT_FOUND",
            "STATE_CONFLICT",
            "BUDGET_NOT_CONFIGURED"
