              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume Reason"
        },
        "watertight": {
          "title": "Watertight",
          "type": "boolean"
        }
      },
      "required": [
        "mesh_version",
        "unit",
        "component_count",
        "watertight",
        "normals_consistent",
        "boundary_edge_count",
        "non_manifold_edge_count",
        "non_manifold_vertex_count"
      ],
      "title": "MeshInspection",
      "type": "object"
    },
